{
  "compilerOptions": {
    "target": "es2023",
    "lib": [],
    "module": "commonjs",
    "jsx": "react",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "moduleResolution": "node"
  },
  "include": ["src"]
}